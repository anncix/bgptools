# DN42 BGP Tool 环境变量配置示例
# 复制为 .env 并按需修改；systemd 可用 systemctl edit bgp-tool 写入 Environment 行
# 也可用 python-dotenv 读取（需 pip install python-dotenv）

# ---------- 基本服务 ----------
BGP_TOOL_HOST=127.0.0.1
BGP_TOOL_PORT=8421
BGP_TOOL_API_KEY=                  # 公网暴露务必设置一个长随机串
BGP_TOOL_SITE_NAME=DN42 BGP Looking Glass
BGP_TOOL_NODE_NAME=node1
BGP_TOOL_NODE_ASN=4242420001

# ---------- BIRD ----------
BGP_TOOL_BIRDC_BIN=birdc
BGP_TOOL_BIRD_SOCKET=/run/bird/bird.ctl
BGP_TOOL_BIRD_RESTRICT=true
BGP_TOOL_BIRD_TIMEOUT=15
BGP_TOOL_DEMO_MODE=false           # 无 bird 时设 true 可体验前端

# ---------- 缓存 ----------
BGP_TOOL_CACHE=true
BGP_TOOL_CACHE_TTL_STATUS=5
BGP_TOOL_CACHE_TTL_PROTOCOLS=10
BGP_TOOL_CACHE_TTL_ROUTES=15
BGP_TOOL_CACHE_TTL_LOOKUP=5
BGP_TOOL_CACHE_TTL_MEMORY=15

# ---------- 外部工具 ----------
BGP_TOOL_TRACEROUTE_BIN=traceroute
BGP_TOOL_TRACEROUTE_MAX_HOPS=15
BGP_TOOL_WHOIS_BIN=whois
BGP_TOOL_WHOIS_SERVER=whois.dn42.us

# ---------- 安全 ----------
BGP_TOOL_RATE_LIMIT=60
